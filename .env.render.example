APP_ENV=production
APP_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com/
DB_HOST=YOUR-MYSQL-HOST
DB_PORT=3306
DB_DATABASE=YOUR-DATABASE
DB_USERNAME=YOUR-DATABASE-USER
DB_PASSWORD=SET-IN-RENDER-DASHBOARD
DB_CHARSET=utf8mb4
DB_SSL_CA=/etc/secrets/aiven-ca.pem
COOPWISE_JWT_SECRET=GENERATE-A-UNIQUE-SECRET-AT-LEAST-32-CHARACTERS
COOPWISE_REFRESH_TOKEN_KEY=GENERATE-A-DIFFERENT-SECRET-AT-LEAST-32-CHARS
COOPWISE_SESSION_HMAC_SECRET=GENERATE-A-THIRD-UNIQUE-LONG-SECRET
COOPWISE_ALLOWED_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app
COOPWISE_FRONTEND_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=SET-YOUR-PAYMONGO-TEST-SECRET-KEY-IN-RENDER
PAYMONGO_WEBHOOK_SECRET=SET-YOUR-PAYMONGO-TEST-WEBHOOK-SECRET-IN-RENDER
PAYMONGO_PAYMENT_METHOD_TYPES=gcash,card
BREVO_API_KEY=SET-YOUR-BREVO-API-KEY-IN-RENDER
BREVO_SENDER_EMAIL=YOUR-VERIFIED-SENDER-EMAIL
BREVO_SENDER_NAME=CoopWise
